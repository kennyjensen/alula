    "driver": "      PROGRAM GAPCONTROL\n      INCLUDE 'XFOIL.INC'\n      INTEGER NC, IC, K, M\n      REAL DIST(IWX)\n      READ(*,*) NC\n      DO 100 IC=1,NC\n        READ(*,*) ANTE,XP(1),YP(1),XP(4),YP(4),NW\n        READ(*,*) (DIST(K),K=1,NW)\n        N=4\n        SST=0.3\n        DO 10 K=1,N\n          S(K)=0.2*(K-1)\n   10   CONTINUE\n        SHARP=.FALSE.\n        IBLTE(1)=2\n        IBLTE(2)=2\n        IPAN(2,1)=1\n        IPAN(2,2)=N\n        NBL(1)=2+NW\n        NBL(2)=2+NW\n        DO 20 K=1,NW\n          X(N+K)=DIST(K)\n          Y(N+K)=0.0\n          IPAN(2+K,1)=N+K\n          IPAN(2+K,2)=N+K\n   20   CONTINUE\n        CALL XICALC\n        DO 30 K=1,NW\n          WRITE(*,'(I3,1X,I3,1X,ES26.17,1X,ES26.17)')\n     &      IC,K,XSSI(2+K,2)-XSSI(2,2),WGAP(K)\n   30   CONTINUE\n  100 CONTINUE\n      END\n",
